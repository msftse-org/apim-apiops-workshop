# Edit every value, then: source .env
export TENANT_ID="YOUR-TENANT-ID"
export AZURE_SUBSCRIPTION_ID="YOUR-SUBSCRIPTION-ID"
export RESOURCE_GROUP="rg-apim-apiops-workshop"
export APIM_NAME="YOUR-GLOBALLY-UNIQUE-APIM-NAME"
export APIC_NAME="YOUR-GLOBALLY-UNIQUE-APIC-NAME"
export LOCATION="westeurope"
export PUBLISHER_EMAIL="YOU@EXAMPLE.COM"

# Use the account selected by az login for this local workshop.
export AZURE_TOKEN_CREDENTIALS="AzureCliCredential"
